{
  "name": "tdvideo",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "build-only": "vite build",
    "preview": "vite preview",
    "type-check": "tsc -b",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check",
    "check": "npm run format:check && npm run lint && npm run type-check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "verify": "npm run check && npm run test:coverage && npm run test:e2e"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.5.0",
    "@mui/material": "^9.5.0",
    "@tanstack/react-router": "^1.170.46",
    "@videojs/hlsjs-video": "^10.6.0",
    "@videojs/react": "^10.6.0",
    "dexie": "^4.4.7",
    "i18next": "^27.2.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^18.0.3",
    "video.js": "^10.6.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@mengtaoxin/evolving": "^0.15.0",
    "@mengtaoxin/oxc-config": "^0.12.0",
    "@playwright/test": "^1.65.1",
    "@tanstack/router-plugin": "^1.169.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.1.1",
    "fake-indexeddb": "^6.2.8",
    "jsdom": "^31.0.1",
    "npm-run-all2": "^9.1.0",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.90.0",
    "oxlint-tsgolint": "^7.0.2008",
    "typescript": "~5.9.3",
    "vite": "^8.3.6",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.1.1"
  },
  "engines": {
    "node": ">=24"
  }
}
